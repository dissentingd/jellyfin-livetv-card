# Copy this file to .env and fill in your own values.
# .env is gitignored -- your API key never gets committed.

JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=

# Optional -- defaults shown
# LIBRARY_NAME=Live TV
# SOURCE_IMAGE=

# Set to false if your server uses a self-signed certificate or plain HTTP
# (common for LAN-only installs, e.g. http://192.168.1.10:8096)
# JELLYFIN_VERIFY_SSL=true
